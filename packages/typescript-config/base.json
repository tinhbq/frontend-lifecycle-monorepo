{
    "compilerOptions": {
        "target": "Es2023",
        "module": "EsNext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "noEmit": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    }
}